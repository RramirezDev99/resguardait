---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'blog'>['data'] }
const { post } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={post.title} description={post.description}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:py-20">
    <a href="/blog" class="text-sm font-medium text-brand-600 hover:text-brand-700">← Volver al blog</a>

    <header class="mt-6 border-b border-slate-200 pb-8">
      <h1 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">{post.title}</h1>
      <p class="mt-4 text-lg text-slate-600">{post.description}</p>
      <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-500">
        <span>{post.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.pubDate.toISOString()}>{fmt(post.pubDate)}</time>
        {post.updatedDate && <span aria-hidden="true">·</span>}
        {post.updatedDate && <span>Actualizado el {fmt(post.updatedDate)}</span>}
      </div>
      {
        post.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {post.tags.map((t) => (
              <li class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">#{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose-custom mt-10">
      <slot />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose-custom { color: var(--color-slate-700); line-height: 1.75; }
  .prose-custom h2 { margin-top: 2.5rem; margin-bottom: 0.75rem; font-size: 1.5rem; font-weight: 700; color: var(--color-ink-900); }
  .prose-custom h3 { margin-top: 2rem; margin-bottom: 0.5rem; font-size: 1.175rem; font-weight: 600; color: var(--color-ink-900); }
  .prose-custom p { margin-bottom: 1.25rem; }
  .prose-custom ul, .prose-custom ol { margin-bottom: 1.25rem; padding-left: 1.35rem; }
  .prose-custom ul { list-style: disc; }
  .prose-custom ol { list-style: decimal; }
  .prose-custom li { margin-bottom: 0.4rem; }
  .prose-custom a { color: var(--color-brand-600); text-decoration: underline; text-underline-offset: 3px; }
  .prose-custom strong { color: var(--color-ink-900); font-weight: 600; }
  .prose-custom blockquote { border-left: 3px solid var(--color-brand-500); padding-left: 1rem; font-style: italic; margin: 1.5rem 0; }
  .prose-custom code { background: var(--color-slate-100); padding: 0.15rem 0.35rem; border-radius: 0.3rem; font-size: 0.9em; }
  .prose-custom pre { background: var(--color-ink-900); color: #e2e8f0; padding: 1rem; border-radius: 0.75rem; overflow-x: auto; margin-bottom: 1.25rem; }
  .prose-custom pre code { background: transparent; padding: 0; }
  .prose-custom img { border-radius: 0.75rem; margin: 1.5rem 0; }
</style>
