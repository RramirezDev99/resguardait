---
import { NAV, SITE, SERVICES } from '@/consts';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-slate-200 bg-slate-50">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="flex items-center gap-2 font-semibold text-ink-900">
        <img src="/favicon.svg" alt="" width="26" height="26" />
        Resguarda<span class="-ml-1 text-brand-600">It</span>
      </a>
      <p class="mt-3 text-sm leading-relaxed text-slate-600">{SITE.tagline}.</p>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-ink-900">Navegación</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {NAV.map((i) => (
          <li><a href={i.href} class="text-slate-600 hover:text-brand-600">{i.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-ink-900">Servicios</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {SERVICES.slice(0, 5).map((s) => (
          <li><a href={`/servicios#${s.slug}`} class="text-slate-600 hover:text-brand-600">{s.title}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-ink-900">Contacto</h2>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li><a href={`mailto:${SITE.email}`} class="hover:text-brand-600">{SITE.email}</a></li>
        <li>{SITE.domain}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-slate-200">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.name}. Todos los derechos reservados.</p>
      <p>Hecho con Astro y desplegado en Cloudflare Pages.</p>
    </div>
  </div>
</footer>
