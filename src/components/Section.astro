---
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  id?: string;
  class?: string;
  center?: boolean;
}
const { eyebrow, title, subtitle, id, class: className = '', center = true } = Astro.props;
---

<section id={id} class:list={['mx-auto max-w-6xl px-4 py-16 sm:py-20', className]}>
  {
    (eyebrow || title || subtitle) && (
      <div class:list={['max-w-2xl', center && 'mx-auto text-center']}>
        {eyebrow && (
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">{eyebrow}</p>
        )}
        {title && <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">{title}</h2>}
        {subtitle && <p class="mt-4 text-lg leading-relaxed text-slate-600">{subtitle}</p>}
      </div>
    )
  }
  <slot />
</section>
