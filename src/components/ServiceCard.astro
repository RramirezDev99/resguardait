---
import Icon from './Icon.astro';
import type { Service } from '@/consts';
interface Props { service: Service; showFeatures?: boolean }
const { service, showFeatures = false } = Astro.props;
---

<article
  id={service.slug}
  class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-6 transition-shadow hover:shadow-lg hover:shadow-slate-200/60"
>
  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
    <Icon name={service.icon} />
  </div>
  <h3 class="mt-4 text-lg font-semibold text-ink-900">{service.title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-slate-600">{service.summary}</p>

  {
    showFeatures && (
      <ul class="mt-4 space-y-2">
        {service.features.map((f) => (
          <li class="flex gap-2 text-sm text-slate-600">
            <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" />
            <span>{f}</span>
          </li>
        ))}
      </ul>
    )
  }
</article>
