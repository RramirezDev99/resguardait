---
import Icon from './Icon.astro';
import type { Plan } from '@/consts';
interface Props { plan: Plan }
const { plan } = Astro.props;
---

<article
  class:list={[
    'relative flex flex-col rounded-2xl border p-7',
    plan.featured
      ? 'border-brand-600 bg-ink-900 text-slate-300 shadow-xl shadow-brand-900/20'
      : 'border-slate-200 bg-white',
  ]}
>
  {
    plan.featured && (
      <span class="absolute -top-3 left-7 rounded-full bg-brand-500 px-3 py-1 text-xs font-semibold text-white">
        Más elegido
      </span>
    )
  }

  <h3 class:list={['text-lg font-semibold', plan.featured ? 'text-white' : 'text-ink-900']}>
    {plan.name}
  </h3>
  <p class="mt-2 text-sm leading-relaxed">{plan.description}</p>

  <p class="mt-6 flex items-baseline gap-1">
    <span class:list={['text-4xl font-bold', plan.featured ? 'text-white' : 'text-ink-900']}>
      {plan.price}
    </span>
    <span class="text-sm text-slate-500">{plan.period}</span>
  </p>

  <ul class="mt-6 flex-1 space-y-3">
    {
      plan.features.map((f) => (
        <li class="flex gap-2 text-sm">
          <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" />
          <span>{f}</span>
        </li>
      ))
    }
  </ul>

  <a
    href="/contacto"
    class:list={[
      'mt-8 rounded-lg px-4 py-2.5 text-center text-sm font-semibold transition-colors',
      plan.featured
        ? 'bg-brand-500 text-white hover:bg-brand-400'
        : 'bg-ink-900 text-white hover:bg-ink-800',
    ]}
  >
    {plan.cta}
  </a>
</article>
