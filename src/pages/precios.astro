---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import PricingCard from '@/components/PricingCard.astro';
import { PLANS, FAQS } from '@/consts';
---

<BaseLayout
  title="Precios"
  description="Planes mensuales de administración de dominios, hosting, seguridad y desarrollo web. Sin contratos largos."
>
  <Section
    eyebrow="Precios"
    title="Planes claros, sin sorpresas"
    subtitle="Todos incluyen la administración técnica completa. Puedes cambiar o cancelar cuando quieras."
  >
    <div class="mt-14 grid items-start gap-6 lg:grid-cols-3">
      {PLANS.map((p) => <PricingCard plan={p} />)}
    </div>
    <p class="mt-8 text-center text-sm text-slate-500">
      Los precios se ajustan según el alcance del proyecto. Escríbenos y te enviamos una cotización cerrada.
    </p>
  </Section>

  <Section eyebrow="Preguntas frecuentes" title="Lo que suelen preguntarnos" class="bg-slate-50/60">
    <div class="mx-auto mt-12 max-w-3xl divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
      {
        FAQS.map((f) => (
          <details class="group px-6 py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-ink-900">
              {f.q}
              <span class="text-brand-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.a}</p>
          </details>
        ))
      }
    </div>
  </Section>
</BaseLayout>
