---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Icon from '@/components/Icon.astro';
import { SITE } from '@/consts';

// ⚠️ Reemplaza WEB3FORMS_ACCESS_KEY por la clave que te llega al correo
// tras registrarte en https://web3forms.com (gratis, sin crear cuenta).
const WEB3FORMS_ACCESS_KEY = 'TU_ACCESS_KEY';

const steps = [
  'Nos cuentas tu situación actual (dominio, web, hosting, correo).',
  'Revisamos tu configuración y detectamos riesgos o mejoras.',
  'Te enviamos una propuesta con alcance, plazo y precio cerrado.',
];

const inputClass =
  'mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-100';
---

<BaseLayout
  title="Contacto"
  description="Escríbenos y recibe un diagnóstico gratuito de tu dominio, hosting y sitio web."
>
  <Section eyebrow="Contacto" title="Cuéntanos qué necesitas" center={false}>
    <div class="mt-12 grid gap-12 lg:grid-cols-2">
      <div>
        <ol class="space-y-5">
          {
            steps.map((s, i) => (
              <li class="flex gap-4">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-sm font-semibold text-brand-700">
                  {i + 1}
                </span>
                <p class="pt-1 text-slate-600">{s}</p>
              </li>
            ))
          }
        </ol>

        <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <h2 class="font-semibold text-ink-900">Prefieres escribir directo</h2>
          <p class="mt-3 text-sm text-slate-600">
            Correo:
            <a href={`mailto:${SITE.email}`} class="font-medium text-brand-600 hover:text-brand-700">
              {SITE.email}
            </a>
          </p>
          <p class="mt-1 text-sm text-slate-600">Respondemos en menos de 24 horas hábiles.</p>
        </div>
      </div>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="rounded-2xl border border-slate-200 bg-white p-7"
      >
        <!-- Configuración de Web3Forms -->
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="Nueva consulta desde resguardait.lat" />
        <input type="hidden" name="from_name" value="Web ResguardaIt" />
        <input type="hidden" name="redirect" value={`${SITE.url}/gracias`} />
        <!-- Honeypot antispam: invisible para personas, tentador para bots -->
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="grid gap-5">
          <div>
            <label for="nombre" class="block text-sm font-medium text-ink-900">Nombre</label>
            <input id="nombre" name="nombre" type="text" required autocomplete="name" class={inputClass} />
          </div>
          <div>
            <label for="empresa" class="block text-sm font-medium text-ink-900">Empresa</label>
            <input id="empresa" name="empresa" type="text" autocomplete="organization" class={inputClass} />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-ink-900">Correo</label>
            <input id="email" name="email" type="email" required autocomplete="email" class={inputClass} />
          </div>
          <div>
            <label for="telefono" class="block text-sm font-medium text-ink-900">
              Teléfono / WhatsApp <span class="font-normal text-slate-400">(opcional)</span>
            </label>
            <input id="telefono" name="telefono" type="tel" autocomplete="tel" class={inputClass} />
          </div>
          <div>
            <label for="servicio" class="block text-sm font-medium text-ink-900">¿Qué te interesa?</label>
            <select id="servicio" name="servicio" class={`${inputClass} bg-white`}>
              <option>Página web</option>
              <option>Dominio y hosting administrado</option>
              <option>Transferencia de dominio</option>
              <option>Ciberseguridad</option>
              <option>Correo corporativo</option>
              <option>Otro</option>
            </select>
          </div>
          <div>
            <label for="mensaje" class="block text-sm font-medium text-ink-900">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="4" class={inputClass}></textarea>
          </div>
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
          >
            Enviar mensaje
            <Icon name="arrow" class="h-4 w-4" />
          </button>
          <p class="text-xs leading-relaxed text-slate-500">
            Usamos tus datos únicamente para responder tu consulta. No los compartimos con terceros.
          </p>
        </div>
      </form>
    </div>
  </Section>
</BaseLayout>
