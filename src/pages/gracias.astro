---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout title="Mensaje enviado" noindex>
  <section class="mx-auto max-w-2xl px-4 py-32 text-center">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-50 text-brand-600">
      <Icon name="check" class="h-7 w-7" />
    </div>
    <h1 class="mt-6 text-3xl font-bold tracking-tight text-ink-900">Mensaje enviado</h1>
    <p class="mt-4 text-slate-600">
      Gracias por escribirnos. Revisamos tu consulta y te respondemos en menos de 24 horas hábiles.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-lg bg-brand-600 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-700">
        Volver al inicio
      </a>
      <a href="/blog" class="rounded-lg border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50">
        Leer el blog
      </a>
    </div>
  </section>
</BaseLayout>
